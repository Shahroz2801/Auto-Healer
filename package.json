{
  "name": "healsite-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:render": "concurrently -k \"next start\" \"tsx src/server/queue/scan-worker.ts\"",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "redis:start": "powershell -NoProfile -Command \"Start-Process -FilePath '.redis-local/redis-server.exe' -ArgumentList '--port 6379 --bind 127.0.0.1 --save 60 1 --dir .redis-local' -WindowStyle Hidden\"",
    "redis:stop": "powershell -NoProfile -Command \".redis-local/redis-cli.exe -h 127.0.0.1 -p 6379 shutdown nosave\"",
    "worker:dev": "tsx src/server/queue/scan-worker.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:update-email": "tsx scripts/update-admin-email.ts",
    "admin:set-role": "tsx scripts/set-user-role.ts",
    "admin:lookup-user": "tsx scripts/lookup-user.ts",
    "admin:delete-user": "tsx scripts/delete-user.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.6.5",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "bullmq": "^6.0.8",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.28.0",
    "mariadb": "^3.5.3",
    "next": "^15.5.22",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
